# @base-ui/react declares an *optional* peer on date-fns@^4, while this app —
# like the web app it was ported from — is on date-fns@^3. The peer is optional
# and nothing imports date-fns through @base-ui/react, but npm still treats the
# mismatch as fatal, which breaks `npm install` on a fresh clone and `npm ci` in
# CI and the release workflow.
#
# Setting this here rather than passing --legacy-peer-deps at each call site
# keeps local installs, CI and release consistent.
legacy-peer-deps=true
