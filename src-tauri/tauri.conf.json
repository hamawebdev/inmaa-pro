{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Inmaa Pro",
  "mainBinaryName": "inmaa-pro",
  "version": "1.0.0",
  "identifier": "com.hamawebdev.inmaa-pro",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "مركز إنماء برو",
        "width": 1440,
        "height": 900,
        "minWidth": 1024,
        "minHeight": 640,
        "create": false
      },
      {
        "label": "lock",
        "title": "مركز إنماء برو",
        "url": "lock.html",
        "width": 900,
        "height": 640,
        "minWidth": 640,
        "minHeight": 520,
        "resizable": false,
        "maximizable": false,
        "create": false
      }
    ],
    "security": {
      "csp": {
        "default-src": "'self'",
        "script-src": "'self'",
        "style-src": "'self' 'unsafe-inline'",
        "img-src": "'self' asset: http://asset.localhost data: blob:",
        "font-src": "'self'",
        "connect-src": "'self' ipc: http://ipc.localhost",
        "object-src": "'none'",
        "frame-src": "'none'",
        "base-uri": "'self'",
        "form-action": "'none'"
      },
      "dangerousDisableAssetCspModification": ["style-src"],
      "assetProtocol": {
        "enable": true,
        "scope": {
          "allow": ["$APPDATA/uploads/**"],
          "deny": ["$APPDATA/uploads/restricted/**"]
        }
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"],
    "windows": {
      "webviewInstallMode": {
        "type": "offlineInstaller",
        "silent": true
      }
    }
  }
}
