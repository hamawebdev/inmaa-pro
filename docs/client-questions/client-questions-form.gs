function createClientQuestionsForm() {
  const form = FormApp.create(FORM.title);
  form
    .setDescription(FORM.description)
    .setConfirmationMessage(FORM.confirmation)
    .setProgressBar(true)
    .setAllowResponseEdits(true)
    .setCollectEmail(false)
    .setShowLinkToRespondAgain(false);

  SECTIONS.forEach(function (section, index) {
    // The first section shares the form's first page; every other one opens a page of its own.
    const head = index === 0 ? form.addSectionHeaderItem() : form.addPageBreakItem();
    head.setTitle(section.title);
    if (section.help) head.setHelpText(section.help);
    section.items.forEach(function (item) {
      addItem(form, item);
    });
  });

  const sheet = SpreadsheetApp.create(FORM.title + ' (الردود)');
  form.setDestination(FormApp.DestinationType.SPREADSHEET, sheet.getId());

  Logger.log('Link to send to the client: ' + form.getPublishedUrl());
  Logger.log('Edit the form: ' + form.getEditUrl());
  Logger.log('Answers arrive in: ' + sheet.getUrl());
  return form.getPublishedUrl();
}

function addItem(form, item) {
  let added;
  switch (item.type) {
    case 'header':
      added = form.addSectionHeaderItem();
      break;
    case 'text':
      added = form.addTextItem();
      if (item.validate === NUMBER) {
        added.setValidation(
          FormApp.createTextValidation().setHelpText('اكتبوا عددًا.').requireNumberGreaterThanOrEqualTo(0).build(),
        );
      }
      break;
    case 'paragraph':
      added = form.addParagraphTextItem();
      break;
    case 'choice':
      added = form.addMultipleChoiceItem().setChoiceValues(item.choices).showOtherOption(Boolean(item.other));
      break;
    case 'checkbox':
      added = form.addCheckboxItem().setChoiceValues(item.choices).showOtherOption(Boolean(item.other));
      break;
    default:
      throw new Error('Unknown item type: ' + item.type);
  }
  added.setTitle(item.title);
  if (item.help) added.setHelpText(item.help);
  if (item.type !== 'header') added.setRequired(false);
  return added;
}
